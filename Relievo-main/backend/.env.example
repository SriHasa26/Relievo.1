NEXCONN_APP_KEY=paste your api
NEXCONN_APP_SECRET=paste your api
# Server API host for your app's data center: api.sg-light-api.com (Singapore), api.us-light-api.com (North America),
# api.sau-light-api.com (Saudi Arabia). Optional backup host is the matching api-b.* domain.
NEXCONN_API_DOMAIN=paste your api
NEXCONN_API_DOMAIN_BACKUP=
# AI order: OpenRouter, then Gemini (only if its key is set), then the keyword extractor.
OPENROUTER_API_KEY=paste your api
# A free model that supports structured outputs (picked from OpenRouter's model list). Fallback: openrouter/free
OPENROUTER_MODEL=particle-ai/particle-1:free
GEMINI_API_KEY=
# Supabase API URL looks like https://<project-ref>.supabase.co (the dashboard link is accepted too).
SUPABASE_URL=paste your api
SUPABASE_ANON_KEY=paste your api
# Secret key (Dashboard > Settings > API Keys: "service_role" or "sb_secret_..."). Backend only.
SUPABASE_SERVICE_ROLE_KEY=paste your api
# Demo role switcher with the shared demo password for the SYNTHETIC accounts. Set false for anything public.
DEMO_LOGIN=true
# Dev only: each defaults to true. ALL THREE must be false for the demo.
MOCK_CHAT=true
MOCK_AI=true
MOCK_DB=true
# Deployment only (see docs/DEPLOY.md): the deployed frontend origin allowed by CORS (comma separated), and NODE_ENV=production.
FRONTEND_URL=
