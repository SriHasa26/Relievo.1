VITE_NEXCONN_APP_KEY=paste your api
# Data center of your Nexconn app: SG (default), NA, SA, OM, BJ. Must match NEXCONN_API_DOMAIN on the backend.
VITE_NEXCONN_AREA_CODE=SG
VITE_SUPABASE_URL=paste your api
VITE_SUPABASE_ANON_KEY=paste your api
VITE_API_BASE_URL=paste your api
# Dev only: in-memory chat stub (BroadcastChannel). MUST be false for the demo.
VITE_MOCK_CHAT=true
